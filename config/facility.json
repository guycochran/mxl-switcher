      "Layout"
    ],
    "selector_out": "selector",
    "keyer_in": "selector",
    "keyer_out": "keyer",
    "encoder_video_in": "keyer",
    "encoder_audio_in": "pgm",
    "legacy_cam_flow": "991e65d8-4fc4-58de-b22a-2d02f5952252"
  }
