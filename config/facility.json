  },
  "program": {
    "_note": "The live program path: selector picks an input, keyer adds graphics, encoder egresses. These reference video_flows keys.",
    "selector_inputs": [
      "cam",
      "playout",
      "pattern",
      "cam2"
    ],
    "_selector_inputs_note": "The portable 4-input demo order (slots 0=cam,1=playout,2=pattern,3=cam2). Used by mxl-routes.js + bring-up. The live prodbots facility exposes the full 7 below.",
    "layout_inputs": [
      "cam",
      "playout",
      "pattern",
      "cam2",
      "guest1",
      "guest2",
      "layout"
    ],
    "layout_input_labels": [
      "Studio Cam 1",
      "Playout",
      "Pattern",
      "Studio Cam 2",
