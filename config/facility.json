      "grouphint": "Input-Selector",
      "writer": "easy-mxl selector (:9604)"
    },
    "keyer": {
      "uuid": "5c73394e-85df-50a3-8988-5edde5b5522a",
      "label": "Keyer PGM",
      "grouphint": "HTML5-Keyer",
      "writer": "easy-mxl keyer (:9605)"
    },
    "stabilized_guest1": {
      "uuid": "57ab1e00-aaaa-4bbb-8ccc-000000000001",
      "label": "Guest 1 Stable",
      "grouphint": "Stabilizer",
      "role": "freewheeling stable copy of a volatile guest flow \u2014 slots point here so a guest reconnect never wedges a reader",
      "writer": "flow_stabilizer.py (default DST)"
    },
    "stabilized_guest2": {
      "uuid": "57ab2e00-aaaa-4bbb-8ccc-000000000001",
      "label": "Guest 2 Stable",
      "grouphint": "Stabilizer",
      "role": "freewheeling stable copy of the volatile Guest 2 flow",
      "writer": "flow_stabilizer.py guest2 <guest2-uuid> <this-uuid>"
    },
    "stabilized_guest3": {
      "uuid": "57ab3e00-aaaa-4bbb-8ccc-000000000001",
      "label": "Guest 3 Stable",
      "grouphint": "Stabilizer",
      "role": "freewheeling stable copy of the volatile Guest 3 flow \u2014 the selector wires HERE so a guest join/drop never re-wires PGM",
      "writer": "flow_stabilizer.py guest3 <guest3-uuid> <this-uuid>"
    },
    "stabilized_guest4": {
      "uuid": "57ab4e00-aaaa-4bbb-8ccc-000000000001",
      "label": "Guest 4 Stable",
      "grouphint": "Stabilizer",
      "role": "freewheeling stable copy of the volatile Guest 4 flow \u2014 the selector wires HERE so a guest join/drop never re-wires PGM",
      "writer": "flow_stabilizer.py guest4 <guest4-uuid> <this-uuid>"
    },
    "stabilized_guest5": {
      "uuid": "57ab5e00-aaaa-4bbb-8ccc-000000000001",
      "label": "Guest 5 Stable",
      "grouphint": "Stabilizer",
      "role": "freewheeling stable copy of the volatile Guest 5 flow \u2014 the selector wires HERE so a guest join/drop never re-wires PGM",
      "writer": "flow_stabilizer.py guest5 <guest5-uuid> <this-uuid>"
    },
    "stabilized_guest6": {
      "uuid": "57ab6e00-aaaa-4bbb-8ccc-000000000001",
      "label": "Guest 6 Stable",
      "grouphint": "Stabilizer",
      "role": "freewheeling stable copy of the volatile Guest 6 flow \u2014 the selector wires HERE so a guest join/drop never re-wires PGM",
      "writer": "flow_stabilizer.py guest6 <guest6-uuid> <this-uuid>"
    }
  },
  "audio_flows": {
    "_note": "Authoritative label->UUID map for audio flows (was duplicated in audio_pgm.py SOURCES/DST + bring-up guest-audio loop).",
    "pgm": {
